# Generates out/ from src/ and checks the result.
# Requires go-jsonnet (for the -c option) and virt-xml-validate. cloud-init is optional.
.DELETE_ON_ERROR:
MAKEFLAGS += --no-builtin-rules --no-builtin-variables --warn-undefined-variables
SHELL := bash
.SHELLFLAGS := -euo pipefail -O nullglob -c

JSONNET ?= jsonnet
VIRT_XML_VALIDATE ?= virt-xml-validate
CLOUD_INIT ?= cloud-init

.PHONY: gen
gen:
	{ echo '// Generated by `make gen` from the directories under src/. Do not edit.'; echo '{'; \
	  for d in src/*/; do d=$$(basename $$d); echo "  $$d: {"; \
	    for f in src/$$d/*.libsonnet; do n=$$(basename $$f .libsonnet); echo "    '$$n': import '$$d/$$n.libsonnet',"; done; \
	    echo '  },'; done; \
	  echo '}'; } > src/registry.libsonnet
	rm -rf out
	$(JSONNET) -J lib -S -c -m out src/main.jsonnet > /dev/null
	for f in out/*/domain.xml; do $(VIRT_XML_VALIDATE) $$f domain; done
	for f in out/*/pools/*.xml; do $(VIRT_XML_VALIDATE) $$f storagepool; done
	for f in out/*/volumes/*/*.xml; do $(VIRT_XML_VALIDATE) $$f storagevol; done
	if command -v $(firstword $(CLOUD_INIT)) > /dev/null; then \
	  for f in out/*/*.d/user-data; do $(CLOUD_INIT) schema -c $$f; done; \
	else \
	  echo 'warning: $(firstword $(CLOUD_INIT)) not found, so user-data was not validated' >&2; \
	fi
